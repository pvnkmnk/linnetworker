# Runtime state, not source.
state.json
# events.log AND its rotated generations (events.log.1, .2, .3). The
# generations are separate paths, so a bare `events.log` line does not cover
# them -- caught by `git status --untracked-files=all` showing .1/.2 listed.
events.log
events.log.*
tail.err
relay.lock
# The claim and heartbeat temporaries sit beside it and are named per-pid, so a
# bare `relay.lock` line does not cover them -- same trap as events.log.*.
relay.lock.tmp
relay.lock.claim.*
__pycache__/

# Holds GRAFANA_AUTH -- a live Grafana admin password. Never commit it.
relay.env
relay.env.*
